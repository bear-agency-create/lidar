[Unit]
Description=Watchdog for robot-nav web stack on :8765
After=network-online.target robot-nav.service

[Service]
Type=oneshot
# Root is required to restart robot-nav.service when recovery is needed.
User=root
Group=root
Environment=HOME=/home/pi
ExecStart=/bin/bash /home/pi/robot_nav/lidar_map/robot-nav-watchdog.sh
