[Unit]
Description=Robot lidar map stack (lidar + encoders + web :8765)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# RemainAfterExit keeps the children running; control-group ensures a stop or
# restart removes every old lidar/drive/map process before the next launch.
KillMode=control-group
User=pi
Group=pi
Environment=HOME=/home/pi
WorkingDirectory=/home/pi/robot_nav/lidar_map
ExecStart=/bin/bash /home/pi/robot_nav/lidar_map/start_drive_map.sh
TimeoutStartSec=90
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
