# Источник: usb (сейчас) | rtsp (Tapo позже)
CAMERA_SOURCE=usb
# 0 = часто встроенная ноутбука, 1 = USB
CAMERA_INDEX=1
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

CAMERA_SHOW_PREVIEW=1
CAMERA_DIGITAL_CENTER=1
CAMERA_DRY_RUN=1
CAMERA_TARGET_FPS=15

# YuNet: ниже score — чувствительнее, больше ложных
FACE_DETECT_SCORE=0.55
FACE_DETECT_MIN_SIZE=28
FACE_MIN_AREA_FRAC=0.006
FACE_CLOSE_AREA_FRAC=0.035
FACE_APPROACH_DELTA=0.003

# --- Tapo (когда CAMERA_SOURCE=rtsp) ---
# TAPO_HOST=172.21.2.114
# TAPO_USER=
# TAPO_PASSWORD=
# TAPO_STREAM=stream2
